+    fn drop_performed(
+        &mut self,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+        data_device: &WlDataDevice,
+    ) {
+        let Some(offer) = drag_offer(data_device) else { return };
+        let surface = surface_key(&offer.surface);
+        let (x, y) = (offer.x, offer.y);
+        self.drag_surface = None;
+        dnd::emit(DragEvent::Left { surface });
+
+        let accepted =
+            offer.with_mime_types(|mimes| mimes.iter().any(|mime| mime == dnd::URI_LIST_MIME));
+        if !accepted || !dnd::has_handler() {
+            offer.destroy();
+            return;
+        }
+        let read_pipe = match offer.receive(dnd::URI_LIST_MIME.to_owned()) {
+            Ok(pipe) => pipe,
+            Err(_) => {
+                offer.destroy();
+                return;
+            },
+        };
+        if set_non_blocking(read_pipe.as_raw_fd()).is_err() {
+            offer.destroy();
+            return;
+        }
+
+        let mut reader_buffer = [0; 4096];
+        let mut content = Vec::new();
+        let _ = self.loop_handle.insert_source(read_pipe, move |_, file, _| {
+            let file = unsafe { file.get_mut() };
+            loop {
+                match file.read(&mut reader_buffer) {
+                    Ok(0) => {
+                        let uris = dnd::parse_uri_list(&String::from_utf8_lossy(&content));
+                        offer.finish();
+                        offer.destroy();
+                        dnd::emit(DragEvent::Dropped { surface, x, y, uris });
+                        break PostAction::Remove;
+                    },
+                    Ok(n) => content.extend_from_slice(&reader_buffer[..n]),
+                    Err(err) if err.kind() == ErrorKind::WouldBlock => break PostAction::Continue,
+                    Err(_) => {
+                        offer.destroy();
+                        break PostAction::Remove;
+                    },
+                }
+            }
+        });
+    }
 
